all: all-am

.SUFFIXES:
.SUFFIXES: .cpp .f .o .obj
$(srcdir)/Makefile.in:  $(srcdir)/Makefile.am  $(am__configure_deps)
	@for dep in $?; do \
	  case '$(am__configure_deps)' in \
	    *$$dep*) \
	      ( cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh ) \
	        && { if test -f $@; then exit 0; else break; fi; }; \
	      exit 1;; \
	  esac; \
	done; \
	echo ' cd $(top_srcdir) && $(AUTOMAKE) --foreign src/Makefile'; \
	$(am__cd) $(top_srcdir) && \
	  $(AUTOMAKE) --foreign src/Makefile
Makefile: $(srcdir)/Makefile.in $(top_builddir)/config.status
	@case '$?' in \
	  *config.status*) \
	    cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh;; \
	  *) \
	    echo ' cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles)'; \
	    cd $(top_builddir) && $(SHELL) ./config.status $(subdir)/$@ $(am__maybe_remake_depfiles);; \
	esac;

$(top_builddir)/config.status: $(top_srcdir)/configure $(CONFIG_STATUS_DEPENDENCIES)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh

$(top_srcdir)/configure:  $(am__configure_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(ACLOCAL_M4):  $(am__aclocal_m4_deps)
	cd $(top_builddir) && $(MAKE) $(AM_MAKEFLAGS) am--refresh
$(am__aclocal_m4_deps):
install-binPROGRAMS: $(bin_PROGRAMS)
	@$(NORMAL_INSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	if test -n "$$list"; then \
	  echo " $(MKDIR_P) '$(DESTDIR)$(bindir)'"; \
	  $(MKDIR_P) "$(DESTDIR)$(bindir)" || exit 1; \
	fi; \
	for p in $$list; do echo "$$p $$p"; done | \
	sed 's/$(EXEEXT)$$//' | \
	while read p p1; do if test -f $$p \
	  ; then echo "$$p"; echo "$$p"; else :; fi; \
	done | \
	sed -e 'p;s,.*/,,;n;h' \
	    -e 's|.*|.|' \
	    -e 'p;x;s,.*/,,;s/$(EXEEXT)$$//;$(transform);s/$$/$(EXEEXT)/' | \
	sed 'N;N;N;s,\n, ,g' | \
	$(AWK) 'BEGIN { files["."] = ""; dirs["."] = 1 } \
	  { d=$$3; if (dirs[d] != 1) { print "d", d; dirs[d] = 1 } \
	    if ($$2 == $$4) files[d] = files[d] " " $$1; \
	    else { print "f", $$3 "/" $$4, $$1; } } \
	  END { for (d in files) print "f", d, files[d] }' | \
	while read type dir files; do \
	    if test "$$dir" = .; then dir=; else dir=/$$dir; fi; \
	    test -z "$$files" || { \
	      echo " $(INSTALL_PROGRAM_ENV) $(INSTALL_PROGRAM) $$files '$(DESTDIR)$(bindir)$$dir'"; \
	      $(INSTALL_PROGRAM_ENV) $(INSTALL_PROGRAM) $$files "$(DESTDIR)$(bindir)$$dir" || exit $$?; \
	    } \
	; done

uninstall-binPROGRAMS:
	@$(NORMAL_UNINSTALL)
	@list='$(bin_PROGRAMS)'; test -n "$(bindir)" || list=; \
	files=`for p in $$list; do echo "$$p"; done | \
	  sed -e 'h;s,^.*/,,;s/$(EXEEXT)$$//;$(transform)' \
	      -e 's/$$/$(EXEEXT)/' \
	`; \
	test -n "$$list" || exit 0; \
	echo " ( cd '$(DESTDIR)$(bindir)' && rm -f" $$files ")"; \
	cd "$(DESTDIR)$(bindir)" && rm -f $$files

clean-binPROGRAMS:
	-test -z "$(bin_PROGRAMS)" || rm -f $(bin_PROGRAMS)

clean-checkLIBRARIES:
	-test -z "$(check_LIBRARIES)" || rm -f $(check_LIBRARIES)

libfastspar.a: $(libfastspar_a_OBJECTS) $(libfastspar_a_DEPENDENCIES) $(EXTRA_libfastspar_a_DEPENDENCIES) 
	$(AM_V_at)-rm -f libfastspar.a
	$(AM_V_AR)$(libfastspar_a_AR) libfastspar.a $(libfastspar_a_OBJECTS) $(libfastspar_a_LIBADD)
	$(AM_V_at)$(RANLIB) libfastspar.a

libfastspar_bootstrap.a: $(libfastspar_bootstrap_a_OBJECTS) $(libfastspar_bootstrap_a_DEPENDENCIES) $(EXTRA_libfastspar_bootstrap_a_DEPENDENCIES) 
	$(AM_V_at)-rm -f libfastspar_bootstrap.a
	$(AM_V_AR)$(libfastspar_bootstrap_a_AR) libfastspar_bootstrap.a $(libfastspar_bootstrap_a_OBJECTS) $(libfastspar_bootstrap_a_LIBADD)
	$(AM_V_at)$(RANLIB) libfastspar_bootstrap.a

libfastspar_pvalues.a: $(libfastspar_pvalues_a_OBJECTS) $(libfastspar_pvalues_a_DEPENDENCIES) $(EXTRA_libfastspar_pvalues_a_DEPENDENCIES) 
	$(AM_V_at)-rm -f libfastspar_pvalues.a
	$(AM_V_AR)$(libfastspar_pvalues_a_AR) libfastspar_pvalues.a $(libfastspar_pvalues_a_OBJECTS) $(libfastspar_pvalues_a_LIBADD)
	$(AM_V_at)$(RANLIB) libfastspar_pvalues.a

libfastspar_reduce.a: $(libfastspar_reduce_a_OBJECTS) $(libfastspar_reduce_a_DEPENDENCIES) $(EXTRA_libfastspar_reduce_a_DEPENDENCIES) 
	$(AM_V_at)-rm -f libfastspar_reduce.a
	$(AM_V_AR)$(libfastspar_reduce_a_AR) libfastspar_reduce.a $(libfastspar_reduce_a_OBJECTS) $(libfastspar_reduce_a_LIBADD)
	$(AM_V_at)$(RANLIB) libfastspar_reduce.a

fastspar$(EXEEXT): $(fastspar_OBJECTS) $(fastspar_DEPENDENCIES) $(EXTRA_fastspar_DEPENDENCIES) 
	@rm -f fastspar$(EXEEXT)
	$(AM_V_CXXLD)$(CXXLINK) $(fastspar_OBJECTS) $(fastspar_LDADD) $(LIBS)

fastspar_bootstrap$(EXEEXT): $(fastspar_bootstrap_OBJECTS) $(fastspar_bootstrap_DEPENDENCIES) $(EXTRA_fastspar_bootstrap_DEPENDENCIES) 
	@rm -f fastspar_bootstrap$(EXEEXT)
	$(AM_V_CXXLD)$(CXXLINK) $(fastspar_bootstrap_OBJECTS) $(fastspar_bootstrap_LDADD) $(LIBS)

fastspar_pvalues$(EXEEXT): $(fastspar_pvalues_OBJECTS) $(fastspar_pvalues_DEPENDENCIES) $(EXTRA_fastspar_pvalues_DEPENDENCIES) 
	@rm -f fastspar_pvalues$(EXEEXT)
	$(AM_V_CXXLD)$(CXXLINK) $(fastspar_pvalues_OBJECTS) $(fastspar_pvalues_LDADD) $(LIBS)

fastspar_reduce$(EXEEXT): $(fastspar_reduce_OBJECTS) $(fastspar_reduce_DEPENDENCIES) $(EXTRA_fastspar_reduce_DEPENDENCIES) 
	@rm -f fastspar_reduce$(EXEEXT)
	$(AM_V_CXXLD)$(CXXLINK) $(fastspar_reduce_OBJECTS) $(fastspar_reduce_LDADD) $(LIBS)

mostlyclean-compile:
	-rm -f *.$(OBJEXT)

distclean-compile:
	-rm -f *.tab.c

